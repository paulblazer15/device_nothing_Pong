<resources>

    <!-- Stock low-power AOD brightness sensor exposed by sensors.ssc.so.
         The vendor sensor type intentionally uses the spelling "amblient".
         The stock brightness and scrim tables match the SystemUI defaults. -->
    <string name="doze_brightness_sensor_type" translatable="false">android.sensor.amblient_light_scene</string>

     <!-- Should we vibrate on an icon animation of the shelf. This should only be active if the
          vibrator is capable of subtle vibrations -->
     <bool name="config_vibrateOnIconAnimation">true</bool>

     <!-- Color of the UDFPS Pressed view -->
     <color name="config_udfpsColor">#ffffff</color>

     <!-- Allow devices override audio panel location to the left side -->
    <bool name="config_audioPanelOnLeftSide">true</bool>
      
</resources>
